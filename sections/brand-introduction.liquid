{% comment %}
  SIN'S COFFEE - Section 02: Brand Introduction
  Features fixed / still parallax background image while scrolling.
{% endcomment %}

<style>
  @media screen and (max-width: 860px) {
    #brand-intro {
      background-image: url('{{ section.settings.bg_image_mobile | default: 'brand-intro-bg-mobile.jpg' | asset_url }}') !important;
    }
  }
</style>

<section 
  class="sins-brand-intro" 
  id="brand-intro" 
  data-section-id="{{ section.id }}"
  style="background-image: url('{{ section.settings.bg_image | default: 'brand-intro-bg.png' | asset_url }}');"
>
  <div class="sins-brand-intro__overlay"></div>
  
  <div class="sins-container sins-brand-intro__inner">
    <div class="sins-brand-intro__grid">
      
      <!-- Left Editorial Column -->
      <div class="sins-brand-intro__text-col" data-reveal="fade-up">
        <div class="sins-section-subhead">
          <span class="subhead-gold-line"></span>
          <span class="subhead-text">{{ section.settings.eyebrow | default: 'THE UNION OF TWO WORLDS' }}</span>
        </div>

        <h2 class="sins-brand-intro__headline">
          <span class="reveal-word">{{ section.settings.title_1 | default: 'INDIAN ROOTS.' }}</span>
          <span class="reveal-word reveal-word--accent">{{ section.settings.title_2 | default: 'BRITISH REFINEMENT.' }}</span>
        </h2>

        <div class="sins-brand-intro__divider">
          <span class="divider-gem"></span>
        </div>

        <p class="sins-brand-intro__copy">
          {{ section.settings.body | default: 'Born from India’s extraordinary coffee-growing heritage and inspired by Britain’s timeless appreciation for refinement, SIN’S COFFEE brings two worlds together.' }}
        </p>

        <div class="sins-brand-intro__credentials">
          <div class="cred-item">
            <span class="cred-num">1,400M+</span>
            <span class="cred-label">Western Ghats Shade Altitude</span>
          </div>
          <div class="cred-separator"></div>
          <div class="cred-item">
            <span class="cred-num">100%</span>
            <span class="cred-label">Handpicked Specialty Arabica</span>
          </div>
          <div class="cred-separator"></div>
          <div class="cred-item">
            <span class="cred-num">LONDON</span>
            <span class="cred-label">Artisan Micro-Roasting</span>
          </div>
        </div>

        <div class="sins-brand-intro__link-wrap">
          <a href="{{ section.settings.link_url | default: '/pages/our-story' }}" class="sins-link-arrow">
            <span>{{ section.settings.link_text | default: 'EXPLORE OUR DUAL HERITAGE' }}</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>

      <!-- Right Media / Glass Atelier Column -->
      <div class="sins-brand-intro__media-col" data-reveal="fade-in-right">
        {% if section.settings.image_primary != blank %}
          <div class="sins-brand-intro__image-stage">
            <div class="sins-image-card sins-image-card--primary">
              <img 
                src="{{ section.settings.image_primary | asset_url }}" 
                alt="SIN'S COFFEE British Refinement" 
                class="sins-parallax-img"
                loading="lazy"
                width="600"
                height="750"
              >
              <div class="sins-image-card__overlay"></div>
            </div>

            {% if section.settings.image_secondary != blank %}
              <div class="sins-image-card sins-image-card--floating">
                <img 
                  src="{{ section.settings.image_secondary | asset_url }}" 
                  alt="Artisan Roasting" 
                  loading="lazy"
                  width="280"
                  height="350"
                >
                <div class="sins-floating-seal">
                  <span class="seal-inner">
                    <svg viewBox="0 0 100 100" class="rotating-text-svg">
                      <path id="circlePath" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="transparent"/>
                      <text>
                        <textPath xlink:href="#circlePath">
                          SIN'S COFFEE • INDIAN HERITAGE •
                        </textPath>
                      </text>
                    </svg>
                    <span class="seal-center-emblem">☕</span>
                  </span>
                </div>
              </div>
            {% endif %}
          </div>
        {% else %}
          <!-- Ultra-Luxury Smoked Glass Atelier Plaque (Accenting the Still Espresso Background) -->
          <div class="sins-brand-intro__glass-stage">
            <div class="sins-glass-badge">
              <div class="sins-glass-badge__header">
                <span class="badge-gem">✦</span>
                <span class="badge-label">ATELIER CRAFTSMANSHIP</span>
              </div>
              <div class="sins-glass-badge__stat">
                <span class="stat-value">9 BAR</span>
                <span class="stat-desc">PRECISION EXTRACTION</span>
              </div>
              <p class="sins-glass-badge__text">
                Master-extracted tiger-stripe crema, balancing intense dark cocoa with wild Malabar cardamom notes.
              </p>
              <div class="sins-glass-badge__meta">
                <span>MAYFAIR, LONDON</span> • <span>EST. 2024</span>
              </div>
            </div>

            <!-- Rotating Luxury Gold Seal -->
            <div class="sins-floating-seal sins-floating-seal--intro">
              <span class="seal-inner">
                <svg viewBox="0 0 100 100" class="rotating-text-svg">
                  <path id="circlePathIntro" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="transparent"/>
                  <text>
                    <textPath xlink:href="#circlePathIntro">
                      SIN'S COFFEE • INDIAN HERITAGE •
                    </textPath>
                  </text>
                </svg>
                <span class="seal-center-emblem">☕</span>
              </span>
            </div>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Introduction",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Still Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Still Background Image (Mobile 9:16)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "THE UNION OF TWO WORLDS"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Headline Line 1",
      "default": "INDIAN ROOTS."
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Headline Line 2",
      "default": "BRITISH REFINEMENT."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Paragraph",
      "default": "Born from India’s extraordinary coffee-growing heritage and inspired by Britain’s timeless appreciation for refinement, SIN’S COFFEE brings two worlds together."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "EXPLORE OUR DUAL HERITAGE"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link Destination",
      "default": "/pages/our-story"
    },
    {
      "type": "image_picker",
      "id": "image_primary",
      "label": "Primary Portrait Image"
    },
    {
      "type": "image_picker",
      "id": "image_secondary",
      "label": "Floating Accent Image"
    }
  ],
  "presets": [
    {
      "name": "Brand Introduction",
      "category": "Story"
    }
  ]
}
{% endschema %}