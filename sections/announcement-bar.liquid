{%- if section.settings.show_announcement -%}
  <div class="sins-announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="sins-container sins-announcement-bar__inner">
      <div class="sins-announcement-bar__content">
        <span class="sins-announcement-bar__pill">{{ section.settings.tag | default: 'ATELIER NOTICE' }}</span>
        <span class="sins-announcement-bar__text">{{ section.settings.text }}</span>
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="sins-announcement-bar__link">
            {{ section.settings.link_text | default: 'DISCOVER' }} →
          </a>
        {%- endif -%}
      </div>
      <div class="sins-announcement-bar__heritage">
        <span>LONDON • BENGALURU</span>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag label",
      "default": "COMPLIMENTARY DELIVERY"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Complimentary UK courier delivery on all orders exceeding £45 • Freshly roasted weekly"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "EXPLORE ALLOCATIONS"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement link",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#181818"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#C6A36B"
    }
  ]
}
{% endschema %}

